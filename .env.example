# ==============================================================================
# KisanVaani AI — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Gnani.ai Conversational Voice API Credentials
GNANI_API_KEY=your_gnani_api_key_here
GNANI_ACCESS_TOKEN=your_gnani_access_token_here
GNANI_ENDPOINT=https://service.gnani.ai

# Google Gemini AI Credentials
GEMINI_API_KEY=your_gemini_api_key_here
