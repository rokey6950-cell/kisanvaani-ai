# KisanVaani AI Backend Configuration
APP_NAME=KisanVaani AI
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration (SQLite for initial local dev, PostgreSQL ready)
DATABASE_URL=sqlite:///./kisanvaani.db

# Path to Agricultural Knowledge Base
KNOWLEDGE_DIR=../knowledge

# AI Voice - Gnani API Configuration (Fill with your credentials)
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v2.5
GNANI_TTS_MODEL=timbre-v2.5
GNANI_STT_ENDPOINT=https://api.gnani.ai/v2/stt
GNANI_TTS_ENDPOINT=https://api.gnani.ai/v2/tts

# Fallback AI Provider (Optional: Google Gemini API for deep agricultural reasoning)
GEMINI_API_KEY=

